# AI Berkshire Web - Environment Configuration
# Copy this file to .env and fill in your API keys

LLM_PROVIDER=deepseek
LLM_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Or use OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=YOUR_OPENAI_API_KEY
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# ==================== 访问与安全开关（可选，默认关闭）====================
# 未配置下面任何一项时：服务只接本机（start.sh 绑 127.0.0.1），/app 会给打开者
# 注入一枚可用 JWT —— 本机面无害，一旦对外（局域网转发/隧道/反代）就等于把
# API 凭据发给任何人。开远程访问之前，先配好 BERKSHIRE_BASIC_AUTH。

# 服务端密钥：配置后 /api/* 需要 JWT（由 /app 注入或 POST /api/auth/login 换取）
# BERKSHIRE_API_TOKEN=

# 浏览器门：格式 user:password。配置后打开静态页面需要输入。
# BERKSHIRE_BASIC_AUTH=

# 来源白名单（默认 auto：放行本机+私网，拒公网）：
#   留空            → auto，只挡非本机/非局域网来源
#   loopback,10.0.0.0/8,... → strict，只放行列出的来源（关键字支持 loopback/gateway/private）
#   BERKSHIRE_CLIENT_GUARD=off → 完全关闭来源限制（回到旧行为，不建议）
# BERKSHIRE_CLIENT_ALLOWLIST=
