[Unit]
Description=AI Berkshire Web - Investment Research Workstation
After=network.target

[Service]
Type=simple
# 批F(2026-09-11): 监听 127.0.0.1 —— 仅本机与 Windows localhost 可达（局域网路径关闭）
ExecStart=/home/q/ai_berkshire_web/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --log-level info
WorkingDirectory=/home/q/ai_berkshire_web
Environment="PATH=/home/q/ai_berkshire_web/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/q/ai_berkshire_web/.env
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
